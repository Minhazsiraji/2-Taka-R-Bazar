{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "2tbr-internal-preview": {
      "distribution": "internal",
      "channel": "2tbr-internal-preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_NATIVE_AUTH_ENABLED": "false",
        "EXPO_PUBLIC_NATIVE_GOOGLE_ENABLED": "false"
      }
    }
  }
}
