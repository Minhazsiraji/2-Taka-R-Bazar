# Never put secrets, service-role keys or production bypass tokens in EXPO_PUBLIC values.
EXPO_PUBLIC_SITE_URL=https://2takarbazar.com
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep true until authenticated native ordering is separately qualified.
EXPO_PUBLIC_DEMO_MODE=true

# Opt-in only after native build, secured RLS, and identity tests.
EXPO_PUBLIC_NATIVE_AUTH_ENABLED=false
# Supabase Auth redirect allowlist required: twotbr://auth/callback
EXPO_PUBLIC_NATIVE_GOOGLE_ENABLED=false

# The approved hero PNG is now locally bundled in mobile/assets/.
# No runtime network URL or EXPO_PUBLIC image setting is required.
